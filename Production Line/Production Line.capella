      <ownedConfigurationItemPkg xsi:type="org.polarsys.capella.core.data.epbs:ConfigurationItemPkg"
          id="8921ce1f-82e7-41fb-a4b5-e74e4bb09049" name="Structure">
        <ownedParts xsi:type="org.polarsys.capella.core.data.cs:Part" id="7aa27359-b393-4813-b1b1-7f0c53c922af"
            name="System" abstractType="#2b361d37-c230-435e-a54b-5d59f032c8f2"/>
        <ownedConfigurationItems xsi:type="org.polarsys.capella.core.data.epbs:ConfigurationItem"
