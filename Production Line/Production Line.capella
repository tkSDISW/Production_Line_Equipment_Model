              <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                  id="27b04f4a-4808-40e7-aec6-13185227c49e" targetElement="#a4d2a45c-537d-43d3-aa2b-5f308ec75926"
                  sourceElement="#1cdd2527-2bec-40cb-8bf3-f36fd76f0f9d"/>
            </ownedFeatures>
            <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
                id="aa1d903f-0257-407d-97ec-b88df72bcb68" name="CP 3" orientation="INOUT">
              <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                  id="561d50d7-d616-4689-a92b-b74597c85339" targetElement="#c56ac10f-3e01-405e-b3cb-bdd2a1498b4d"
                  sourceElement="#aa1d903f-0257-407d-97ec-b88df72bcb68"/>
              <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                  id="3e3813ee-0f95-4917-8378-16b82635e7da" targetElement="#7b8003ae-2044-43ca-9044-19674ae2b167"
                  sourceElement="#aa1d903f-0257-407d-97ec-b88df72bcb68"/>
            </ownedFeatures>
          </ownedLogicalComponents>
        </ownedLogicalComponents>
        <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
