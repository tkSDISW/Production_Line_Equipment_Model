        <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
            id="43f3ca86-31b0-4358-a2b3-88deab2da32f" name="Logical System">
          <ownedFeatures xsi:type="org.polarsys.capella.core.data.cs:Part" id="32580e7f-3f92-4887-a267-a358907af827"
              name="Master TR88 Seven State " abstractType="#5c74d990-9098-48cf-a445-59182d69fa9a"/>
          <ownedFeatures xsi:type="org.polarsys.capella.core.data.cs:Part" id="0fa1be0c-ae2a-4f4d-96d5-6a7eb6455e73"
              name="Infeed Load" abstractType="#529c290e-f4b1-474f-9000-4fd0e04f1252"/>
          <ownedFeatures xsi:type="org.polarsys.capella.core.data.cs:Part" id="aa5ec7ba-a377-4284-9358-d6cb20be47c1"
              name="Filling Station" abstractType="#bcd6599d-8ba8-43bf-920f-13d1b810ae97"/>
          <ownedComponentRealizations xsi:type="org.polarsys.capella.core.data.cs:ComponentRealization"
              id="73df2e7d-ed81-44e0-91d9-9cbd34c031fe" targetElement="#d9113f53-bd75-4226-98fd-0b2f8a238657"
              sourceElement="#43f3ca86-31b0-4358-a2b3-88deab2da32f"/>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="5c74d990-9098-48cf-a445-59182d69fa9a" name="Master TR88 Seven State ">
            <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
                id="e82b2613-72ed-46a0-8843-5b74af966c73" targetElement="#c40e99f0-78a1-4f01-92ae-cc0e0338f1a9"
                sourceElement="#5c74d990-9098-48cf-a445-59182d69fa9a"/>
            <ownedStateMachines xsi:type="org.polarsys.capella.core.data.capellacommon:StateMachine"
                id="adf70202-7826-4c7a-9fd9-cbca405ae2ad" name="StateMachine 1">
              <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                  id="5c5ab4f8-7238-4995-b890-813c0bf634a2" name="Default Region"
                  involvedStates="#c943619b-a930-4fbd-bf6f-cd510db794ce #a09d6923-2fd4-4159-8163-891a4f4bca5e #b1bf0b6d-48c7-48b7-8bcc-529ce617fe77 #d03f2477-24d3-4585-b10f-c847928a340d #1aa700b9-5d61-4e0c-82cf-a923352190df #5fef6834-a840-485f-a672-093cc2896514 #f10d60fc-e18a-4026-94af-b9e6a1af0e62">
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="c943619b-a930-4fbd-bf6f-cd510db794ce" name="Stopped" description="&lt;p>Per ANSI/ISA-TR88.00.02: the machine is halted and not ready to produce. This is the default state after power-up or a full Stop, before any Reset has been issued. No PackTags/recipe data are being processed.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="7f390943-efac-44d6-a8d8-9072edcf39ca" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="a09d6923-2fd4-4159-8163-891a4f4bca5e" name="Idle" description="&lt;p>Per ANSI/ISA-TR88.00.02: the machine has been reset and is clean/ready to run, waiting for a Start command. This is the common entry point reached from Stopped, Complete, or Aborted after their respective Reset/Clear events.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="4e253981-5a62-41c8-a795-a057ec536c54" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="b1bf0b6d-48c7-48b7-8bcc-529ce617fe77" name="Execute" description="&lt;p>Per ANSI/ISA-TR88.00.02: the machine is actively producing/processing product. This is the sole 'productive' wait state in the model and the source of all exception paths (Hold, Suspend, Abort) as well as the normal completion path (state complete).&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="801642ae-f771-49d9-8ece-d904856d07c9" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="d03f2477-24d3-4585-b10f-c847928a340d" name="Complete" description="&lt;p>Per ANSI/ISA-TR88.00.02: the machine has finished its programmed run (batch/job/cycle) without exception and is holding in this state until a Reset command returns it to Idle for the next run.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="9ec6c8e5-ff56-4469-a77c-2305aa86b848" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="1aa700b9-5d61-4e0c-82cf-a923352190df" name="Held" description="&lt;p>Per ANSI/ISA-TR88.00.02: a lighter-weight pause triggered by a condition internal to the machine itself — low material, a minor sensor flag, or an operator intervention need. Distinct from Aborted in that no fault is logged and no Clear/root-cause step is required; Unhold returns directly to Execute.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="b228ed6f-e34c-4041-95a9-ed9f23b5c75a" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="5fef6834-a840-485f-a672-093cc2896514" name="Suspended" description="&lt;p>Per ANSI/ISA-TR88.00.02: a lighter-weight pause triggered by a condition external to the machine — typically a line-level signal such as the downstream station being full (blocked) or the upstream station not yet delivering material (starved). As with Held, no fault is logged; Unsuspend returns directly to Execute once the line condition clears.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="a335690b-2e61-485d-8ef6-604c9d296035" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="f10d60fc-e18a-4026-94af-b9e6a1af0e62" name="Aborted" description="&lt;p>Per ANSI/ISA-TR88.00.02: the machine has faulted during Execute in a way that cannot be resolved by Hold or Suspend. The machine cannot leave this state except via an explicit Clear command, by design — this prevents the machine from resuming with an unaddressed fault. Recovery requires diagnosis/repair before Clear returns it to Idle.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="b0707af7-3047-49e5-81f5-f206734952ad" name="region"/>
                </ownedStates>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="0851752a-de02-45f0-89bb-0dd2b966c460" description="&lt;p>The &amp;#39;start&amp;#39; command. Issued from Idle once the machine is ready to begin production; moves the machine into Execute.&lt;/p>&#xA;"
                    triggerDescription="" source="#a09d6923-2fd4-4159-8163-891a4f4bca5e"
                    target="#b1bf0b6d-48c7-48b7-8bcc-529ce617fe77" triggers="#cd6016d8-0fe9-45b4-a70b-e18c1ff4add2"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="5edcb522-cc21-44da-a49d-e870853f8b2f" name="Process Complete"
                    description="&lt;p>The 'state complete' event (SC in TR88 notation), not an operator command but an internal condition raised automatically when the current production run finishes normally. Moves the machine from Execute to Complete without passing through Held, Suspended, or Aborted.&lt;/p>"
                    triggerDescription="" source="#b1bf0b6d-48c7-48b7-8bcc-529ce617fe77"
                    target="#d03f2477-24d3-4585-b10f-c847928a340d" triggers="#3d1f2b89-09d5-4aa7-9f2d-0a469609ac20"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="d78b6521-d050-4c9d-b9c4-86727a8a6b70" description="&lt;p>The 'suspend' command, raised when an external/line-level condition (e.g. downstream full, upstream empty) requires the machine to pause. Moves Execute to Suspended.&lt;/p>"
                    triggerDescription="" source="#b1bf0b6d-48c7-48b7-8bcc-529ce617fe77"
                    target="#5fef6834-a840-485f-a672-093cc2896514" triggers="#dffb0f1a-9a3b-4f4a-9313-2378c2570bcd"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="6a519dbe-6ac5-4456-a9cc-b0f3fc6c973f" description="&lt;p>The 'hold' command, raised when an internal condition (e.g. low material, minor sensor flag, operator intervention) requires the machine to pause. Moves Execute to Held.&lt;/p>"
                    triggerDescription="" source="#b1bf0b6d-48c7-48b7-8bcc-529ce617fe77"
                    target="#1aa700b9-5d61-4e0c-82cf-a923352190df" triggers="#2091100a-571d-402d-b4e7-269c01ec26ee"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="b866874c-7ec1-49d4-8a0a-ea926a2d5627" description="&lt;p>The &amp;#39;abort&amp;#39; event/command, raised when a fault occurs during Execute that cannot be handled by Hold or Suspend. Moves Execute to Aborted; per TR88, this transition can occur from most/any state, though this model currently only wires it from Execute.&lt;/p>&#xA;"
                    triggerDescription="" source="#b1bf0b6d-48c7-48b7-8bcc-529ce617fe77"
                    target="#f10d60fc-e18a-4026-94af-b9e6a1af0e62" triggers="#2d72bf14-dac4-47e6-90a2-8e6a6946c1c2"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="78917e86-0c52-4a70-a6af-6145d7a8e78a" description="&lt;p>The &amp;#39;clear&amp;#39; command, issued once the fault causing Abort has been diagnosed and corrected. This is the only way out of Aborted, by design, ensuring no fault goes unacknowledged. Moves Aborted to Idle.&lt;/p>&#xA;"
                    triggerDescription="" source="#f10d60fc-e18a-4026-94af-b9e6a1af0e62"
                    target="#a09d6923-2fd4-4159-8163-891a4f4bca5e" triggers="#73fcf1dd-1f92-4c88-b25a-8263f10465e1"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="cbc327de-3569-45fb-9929-26a09611efc1" description="&lt;p>The 'reset' command, issued from Complete once a finished run has been acknowledged, preparing the machine for its next run. Moves Complete to Idle.&lt;/p>"
                    triggerDescription="" source="#d03f2477-24d3-4585-b10f-c847928a340d"
                    target="#a09d6923-2fd4-4159-8163-891a4f4bca5e" triggers="#88ebd2bd-ae30-43b4-af7b-fd074e7e75f6"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="545d8a35-7fea-4b3d-82bd-699b166c2368" description="&lt;p>The &amp;#39;reset&amp;#39; command, issued from Stopped to prepare the machine to run again after a full stop. Moves Stopped to Idle.&lt;/p>&#xA;"
                    triggerDescription="" source="#c943619b-a930-4fbd-bf6f-cd510db794ce"
                    target="#a09d6923-2fd4-4159-8163-891a4f4bca5e" triggers="#88ebd2bd-ae30-43b4-af7b-fd074e7e75f6"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="3388d3fc-8a86-435c-a552-0f479950932d" description="&lt;p>The 'unhold' command, issued once the internal condition causing Hold has been resolved. Moves Held directly back to Execute — no Clear or diagnostic step required, since Held is not a logged fault.&lt;/p>"
                    triggerDescription="" source="#1aa700b9-5d61-4e0c-82cf-a923352190df"
                    target="#b1bf0b6d-48c7-48b7-8bcc-529ce617fe77" triggers="#458458d8-39c7-4a29-a2d5-dbe847bbc7db"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="79a7abc3-2696-4207-aae5-e79180de943e" description="&lt;p>The 'unsuspend' command, issued once the external/line-level condition causing Suspend has resolved. Moves Suspended directly back to Execute — no Clear or diagnostic step required, since Suspended is not a logged fault.&lt;/p>"
                    triggerDescription="" source="#5fef6834-a840-485f-a672-093cc2896514"
                    target="#b1bf0b6d-48c7-48b7-8bcc-529ce617fe77" triggers="#26c2b103-9c6d-4594-8a45-23bc74d3715d"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="22db8c22-fbe2-4d3e-a374-47cfecd5124a" description="&lt;p>The &amp;#39;stop&amp;#39; command, typically issued for a planned shutdown of the machine. Moves Execute to Stopped; a subsequent Reset is required before the machine can run again.&lt;/p>&#xA;"
                    triggerDescription="" source="#b1bf0b6d-48c7-48b7-8bcc-529ce617fe77"
                    target="#c943619b-a930-4fbd-bf6f-cd510db794ce" triggers="#a9556d07-c77a-4c92-bced-269417bbe4a9"/>
              </ownedRegions>
            </ownedStateMachines>
            <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
                id="312dd33f-39ed-4fd2-a322-8c97d3dca183" name="Line Control I/F">
              <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                  id="236b66ad-4081-4775-a01a-c82329b5fc09" targetElement="#37d8bb13-b1bd-4457-b15a-d3a119516d54"
                  sourceElement="#312dd33f-39ed-4fd2-a322-8c97d3dca183"/>
              <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                  id="e8083bd3-2696-4fee-b70f-28dd0090aaf0" targetElement="#9e12e5a9-4f4b-4523-a08c-5c502b36e93e"
                  sourceElement="#312dd33f-39ed-4fd2-a322-8c97d3dca183"/>
            </ownedFeatures>
            <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
                id="9f48f188-183d-4fbb-a166-17f7feb6ba1e" name="Operator I/F" orientation="INOUT">
              <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                  id="f0311e12-ac46-47c8-9ca9-750f2f4d864d" targetElement="#c6b9a1e5-5fe0-4cfc-b09e-47aa9b73ae13"
                  sourceElement="#9f48f188-183d-4fbb-a166-17f7feb6ba1e"/>
            </ownedFeatures>
          </ownedLogicalComponents>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="529c290e-f4b1-474f-9000-4fd0e04f1252" name="Infeed Load">
            <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
                id="819c3595-2529-40d5-a4c1-80dc87a62c3c" targetElement="#445fe798-4d9a-48ca-ad32-085f0630d90c"
                sourceElement="#529c290e-f4b1-474f-9000-4fd0e04f1252"/>
            <ownedStateMachines xsi:type="org.polarsys.capella.core.data.capellacommon:StateMachine"
                id="7c3aa67d-1e07-465d-b848-73767cbc6aa6" name="StateMachine 1">
              <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                  id="cb40fc0d-9fed-43b0-9427-f4e524950030" name="Default Region"
                  involvedStates="#782f950c-f208-4204-a808-2df6d70cabad #7dbab6e1-02b0-4ed8-a6a9-78e38467218e #e79f5db6-b443-4205-815b-d2fe86288ba8 #6ce34860-0c5d-4bd0-826e-ce5cb8abdfdd #35a1f871-577a-4896-9bd4-45b3427969d9 #689e8085-c77c-486d-8021-c997c8e21c09 #3b1bcd8d-a434-45da-90d7-3dd4fe40581e">
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="782f950c-f208-4204-a808-2df6d70cabad" name="Stopped" description="&lt;p>Per ANSI/ISA-TR88.00.02: the machine is halted and not ready to produce. This is the default state after power-up or a full Stop, before any Reset has been issued. No PackTags/recipe data are being processed.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="b0c0a03d-eeba-4e8a-900c-9581418af389" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="7dbab6e1-02b0-4ed8-a6a9-78e38467218e" name="Idle" description="&lt;p>Per ANSI/ISA-TR88.00.02: the machine has been reset and is clean/ready to run, waiting for a Start command. This is the common entry point reached from Stopped, Complete, or Aborted after their respective Reset/Clear events.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="90711993-b039-45bc-8be0-20add3653438" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="e79f5db6-b443-4205-815b-d2fe86288ba8" name="Execute" description="&lt;p>Per ANSI/ISA-TR88.00.02: the machine is actively producing/processing product. This is the sole 'productive' wait state in the model and the source of all exception paths (Hold, Suspend, Abort) as well as the normal completion path (state complete).&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="68118b95-b452-44b1-b508-4ad4187e15c7" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="6ce34860-0c5d-4bd0-826e-ce5cb8abdfdd" name="Complete" description="&lt;p>Per ANSI/ISA-TR88.00.02: the machine has finished its programmed run (batch/job/cycle) without exception and is holding in this state until a Reset command returns it to Idle for the next run.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="ee9b14c5-d711-4766-b737-3a13ddb1c893" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="35a1f871-577a-4896-9bd4-45b3427969d9" name="Held" description="&lt;p>Per ANSI/ISA-TR88.00.02: a lighter-weight pause triggered by a condition internal to the machine itself — low material, a minor sensor flag, or an operator intervention need. Distinct from Aborted in that no fault is logged and no Clear/root-cause step is required; Unhold returns directly to Execute.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="e0e55211-9819-40fb-899f-5f20b4871010" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="689e8085-c77c-486d-8021-c997c8e21c09" name="Suspended" description="&lt;p>Per ANSI/ISA-TR88.00.02: a lighter-weight pause triggered by a condition external to the machine — typically a line-level signal such as the downstream station being full (blocked) or the upstream station not yet delivering material (starved). As with Held, no fault is logged; Unsuspend returns directly to Execute once the line condition clears.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="9e0e6871-50bf-4f16-b28e-72b46269aa21" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="3b1bcd8d-a434-45da-90d7-3dd4fe40581e" name="Aborted" description="&lt;p>Per ANSI/ISA-TR88.00.02: the machine has faulted during Execute in a way that cannot be resolved by Hold or Suspend. The machine cannot leave this state except via an explicit Clear command, by design — this prevents the machine from resuming with an unaddressed fault. Recovery requires diagnosis/repair before Clear returns it to Idle.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="9c28c9b3-e01e-4d08-85f3-eb738b43a1e5" name="region"/>
                </ownedStates>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="57c10ffc-c100-42fb-9eb2-d9683011fc8f" description="&lt;p>The &amp;#39;start&amp;#39; command. Issued from Idle once the machine is ready to begin production; moves the machine into Execute.&lt;/p>&#xA;"
                    triggerDescription="" source="#7dbab6e1-02b0-4ed8-a6a9-78e38467218e"
                    target="#e79f5db6-b443-4205-815b-d2fe86288ba8" triggers="#e5b7cf28-b7b3-4e13-82e1-38e0ef37b48a"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="481daf90-f8f8-4a93-973b-88e674c94091" name="Process Complete"
                    description="&lt;p>The 'state complete' event (SC in TR88 notation), not an operator command but an internal condition raised automatically when the current production run finishes normally. Moves the machine from Execute to Complete without passing through Held, Suspended, or Aborted.&lt;/p>"
                    triggerDescription="" source="#e79f5db6-b443-4205-815b-d2fe86288ba8"
                    target="#6ce34860-0c5d-4bd0-826e-ce5cb8abdfdd" triggers="#1c6e2719-a622-40e2-a5d6-81d7ca48d4de"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="36c2e14c-19ed-41dc-877c-c4d8497b7c5e" description="&lt;p>The 'suspend' command, raised when an external/line-level condition (e.g. downstream full, upstream empty) requires the machine to pause. Moves Execute to Suspended.&lt;/p>"
                    triggerDescription="" source="#e79f5db6-b443-4205-815b-d2fe86288ba8"
                    target="#689e8085-c77c-486d-8021-c997c8e21c09" triggers="#0fd528a6-4acd-4400-96de-31596573ab75"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="8b312138-a260-4ca8-a7e3-8219a7815363" description="&lt;p>The 'hold' command, raised when an internal condition (e.g. low material, minor sensor flag, operator intervention) requires the machine to pause. Moves Execute to Held.&lt;/p>"
                    triggerDescription="" source="#e79f5db6-b443-4205-815b-d2fe86288ba8"
                    target="#35a1f871-577a-4896-9bd4-45b3427969d9" triggers="#d5227c1f-4f41-44e4-8427-42e2614aee78"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="27da339f-3222-4244-8d44-ed0bdf7d80e1" description="&lt;p>The &amp;#39;abort&amp;#39; event/command, raised when a fault occurs during Execute that cannot be handled by Hold or Suspend. Moves Execute to Aborted; per TR88, this transition can occur from most/any state, though this model currently only wires it from Execute.&lt;/p>&#xA;"
                    triggerDescription="" source="#e79f5db6-b443-4205-815b-d2fe86288ba8"
                    target="#3b1bcd8d-a434-45da-90d7-3dd4fe40581e" triggers="#bfaca94b-ca5e-423b-8367-61f6ba07ac9a"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="756abf90-366c-4df4-b4c7-7001cb12d0a0" description="&lt;p>The &amp;#39;clear&amp;#39; command, issued once the fault causing Abort has been diagnosed and corrected. This is the only way out of Aborted, by design, ensuring no fault goes unacknowledged. Moves Aborted to Idle.&lt;/p>&#xA;"
                    triggerDescription="" source="#3b1bcd8d-a434-45da-90d7-3dd4fe40581e"
                    target="#7dbab6e1-02b0-4ed8-a6a9-78e38467218e" triggers="#9815a2ac-ee92-43bb-8aa8-cac85fc881a4"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="24adcc08-983e-4eb8-a4e8-448210a70ffe" description="&lt;p>The 'reset' command, issued from Complete once a finished run has been acknowledged, preparing the machine for its next run. Moves Complete to Idle.&lt;/p>"
                    triggerDescription="" source="#6ce34860-0c5d-4bd0-826e-ce5cb8abdfdd"
                    target="#7dbab6e1-02b0-4ed8-a6a9-78e38467218e" triggers="#0d541da9-b58f-4b3c-ac8e-4ec42cb42a10"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="b81b2280-0afe-4998-b391-0ff89de2d7bb" description="&lt;p>The &amp;#39;reset&amp;#39; command, issued from Stopped to prepare the machine to run again after a full stop. Moves Stopped to Idle.&lt;/p>&#xA;"
                    triggerDescription="" source="#782f950c-f208-4204-a808-2df6d70cabad"
                    target="#7dbab6e1-02b0-4ed8-a6a9-78e38467218e" triggers="#0d541da9-b58f-4b3c-ac8e-4ec42cb42a10"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="535e494d-755e-4f7e-9084-d112e42dcef8" description="&lt;p>The 'unhold' command, issued once the internal condition causing Hold has been resolved. Moves Held directly back to Execute — no Clear or diagnostic step required, since Held is not a logged fault.&lt;/p>"
                    triggerDescription="" source="#35a1f871-577a-4896-9bd4-45b3427969d9"
                    target="#e79f5db6-b443-4205-815b-d2fe86288ba8" triggers="#5775db58-9921-430a-bd56-ed9b921cc1a2"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="b5a45595-9f09-4fcd-84de-8cf6fa0aa3c0" description="&lt;p>The 'unsuspend' command, issued once the external/line-level condition causing Suspend has resolved. Moves Suspended directly back to Execute — no Clear or diagnostic step required, since Suspended is not a logged fault.&lt;/p>"
                    triggerDescription="" source="#689e8085-c77c-486d-8021-c997c8e21c09"
                    target="#e79f5db6-b443-4205-815b-d2fe86288ba8" triggers="#7f28128f-09c6-4a54-8245-af317e947e89"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="42f771ee-47f5-42b3-aba1-0f5f050815f5" description="&lt;p>The &amp;#39;stop&amp;#39; command, typically issued for a planned shutdown of the machine. Moves Execute to Stopped; a subsequent Reset is required before the machine can run again.&lt;/p>&#xA;"
                    triggerDescription="" source="#e79f5db6-b443-4205-815b-d2fe86288ba8"
                    target="#782f950c-f208-4204-a808-2df6d70cabad" triggers="#795c9e42-292f-4ca0-b964-a2145db4e460"/>
              </ownedRegions>
            </ownedStateMachines>
            <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
                id="76660931-fa0f-4e84-a7dd-889f9740d9cf" name="Line Control I/F">
              <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                  id="7619bab2-01c0-4edd-8328-03300a0caca4" targetElement="#e43a30cb-47d3-4bab-9a76-294076df2333"
                  sourceElement="#76660931-fa0f-4e84-a7dd-889f9740d9cf"/>
              <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                  id="a9f372d6-90f4-4236-ba9f-09d366e78ff9" targetElement="#f4856bc4-043a-460f-a518-9ac2b2afff92"
                  sourceElement="#76660931-fa0f-4e84-a7dd-889f9740d9cf"/>
            </ownedFeatures>
            <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
                id="3271e34f-f7a3-4901-ac09-3a24c20d936b" name="Operator I/F" orientation="INOUT">
              <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                  id="cb11b023-bf86-435f-842e-c55a91c76a55" targetElement="#eb0f0b73-8a63-4a1d-9028-2d9e9effaa38"
                  sourceElement="#3271e34f-f7a3-4901-ac09-3a24c20d936b"/>
            </ownedFeatures>
          </ownedLogicalComponents>
          <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
              id="bcd6599d-8ba8-43bf-920f-13d1b810ae97" name="Filling Station">
            <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
                id="7dcfabfd-0943-4837-b429-8f748d53d90a" targetElement="#010155c8-c2fa-472c-a229-895b204d1a02"
                sourceElement="#bcd6599d-8ba8-43bf-920f-13d1b810ae97"/>
            <ownedStateMachines xsi:type="org.polarsys.capella.core.data.capellacommon:StateMachine"
                id="e424613b-509d-4b93-ae79-6b8639878be2" name="StateMachine 1">
              <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                  id="5e6dc927-03cc-4951-9ea4-322f8142f5d6" name="Default Region"
                  involvedStates="#e055180d-1564-4836-a79e-f2f53b4c5ba5 #10bcee68-3230-4ab5-ab0b-b2f30ff50ee6 #e976ea35-8b17-4476-b753-05011a4e06d3 #1e4ebd1c-a1b4-4a38-8c6f-1bf075be2efa #f7be3080-a249-4800-9ef3-e4d41b2f617f #45f2a968-bbfb-4be8-9627-5df682308606 #994078d8-18a1-4b9c-92ea-8a132b222418">
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="e055180d-1564-4836-a79e-f2f53b4c5ba5" name="Stopped" description="&lt;p>Per ANSI/ISA-TR88.00.02: the machine is halted and not ready to produce. This is the default state after power-up or a full Stop, before any Reset has been issued. No PackTags/recipe data are being processed.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="939335a9-83f6-4414-91c1-6e2e6666e295" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="10bcee68-3230-4ab5-ab0b-b2f30ff50ee6" name="Idle" description="&lt;p>Per ANSI/ISA-TR88.00.02: the machine has been reset and is clean/ready to run, waiting for a Start command. This is the common entry point reached from Stopped, Complete, or Aborted after their respective Reset/Clear events.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="28b3c38f-4baf-4e10-9e07-f67665498fc0" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="e976ea35-8b17-4476-b753-05011a4e06d3" name="Execute" description="&lt;p>Per ANSI/ISA-TR88.00.02: the machine is actively producing/processing product. This is the sole 'productive' wait state in the model and the source of all exception paths (Hold, Suspend, Abort) as well as the normal completion path (state complete).&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="396b3ed9-444d-4a29-9b3a-f2433475050b" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="1e4ebd1c-a1b4-4a38-8c6f-1bf075be2efa" name="Complete" description="&lt;p>Per ANSI/ISA-TR88.00.02: the machine has finished its programmed run (batch/job/cycle) without exception and is holding in this state until a Reset command returns it to Idle for the next run.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="b650ab46-6ef6-412b-8a21-16a3955c6a6e" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="f7be3080-a249-4800-9ef3-e4d41b2f617f" name="Held" description="&lt;p>Per ANSI/ISA-TR88.00.02: a lighter-weight pause triggered by a condition internal to the machine itself — low material, a minor sensor flag, or an operator intervention need. Distinct from Aborted in that no fault is logged and no Clear/root-cause step is required; Unhold returns directly to Execute.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="dbea5a1b-c968-4d0f-8a28-5fd6e0e95975" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="45f2a968-bbfb-4be8-9627-5df682308606" name="Suspended" description="&lt;p>Per ANSI/ISA-TR88.00.02: a lighter-weight pause triggered by a condition external to the machine — typically a line-level signal such as the downstream station being full (blocked) or the upstream station not yet delivering material (starved). As with Held, no fault is logged; Unsuspend returns directly to Execute once the line condition clears.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="1dd4aa78-a378-48f7-a93c-4e95eb4f5080" name="region"/>
                </ownedStates>
                <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                    id="994078d8-18a1-4b9c-92ea-8a132b222418" name="Aborted" description="&lt;p>Per ANSI/ISA-TR88.00.02: the machine has faulted during Execute in a way that cannot be resolved by Hold or Suspend. The machine cannot leave this state except via an explicit Clear command, by design — this prevents the machine from resuming with an unaddressed fault. Recovery requires diagnosis/repair before Clear returns it to Idle.&lt;/p>">
                  <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                      id="f6e32db3-e713-41e1-80c0-d534f4f899ed" name="region"/>
                </ownedStates>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="b1189cc8-0885-4f68-ae92-e870db964e9a" description="&lt;p>The &amp;#39;start&amp;#39; command. Issued from Idle once the machine is ready to begin production; moves the machine into Execute.&lt;/p>&#xA;"
                    triggerDescription="" source="#10bcee68-3230-4ab5-ab0b-b2f30ff50ee6"
                    target="#e976ea35-8b17-4476-b753-05011a4e06d3" triggers="#76f58de5-1e64-4382-a51e-5febbb7e6df7"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="07501a2a-60c9-4b84-ac3d-5ecc5e2202e1" name="Process Complete"
                    description="&lt;p>The 'state complete' event (SC in TR88 notation), not an operator command but an internal condition raised automatically when the current production run finishes normally. Moves the machine from Execute to Complete without passing through Held, Suspended, or Aborted.&lt;/p>"
                    triggerDescription="" source="#e976ea35-8b17-4476-b753-05011a4e06d3"
                    target="#1e4ebd1c-a1b4-4a38-8c6f-1bf075be2efa" triggers="#9a4a5953-e8c3-4216-86fd-813498e514c5"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="ba42dc6b-167e-4154-af75-958a2e4afe13" description="&lt;p>The 'suspend' command, raised when an external/line-level condition (e.g. downstream full, upstream empty) requires the machine to pause. Moves Execute to Suspended.&lt;/p>"
                    triggerDescription="" source="#e976ea35-8b17-4476-b753-05011a4e06d3"
                    target="#45f2a968-bbfb-4be8-9627-5df682308606" triggers="#f556e1c5-79f0-475d-a4b4-08bac24e09ff"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="b9036b9e-e74a-4659-b011-132fd55e8740" description="&lt;p>The 'hold' command, raised when an internal condition (e.g. low material, minor sensor flag, operator intervention) requires the machine to pause. Moves Execute to Held.&lt;/p>"
                    triggerDescription="" source="#e976ea35-8b17-4476-b753-05011a4e06d3"
                    target="#f7be3080-a249-4800-9ef3-e4d41b2f617f" triggers="#35670c09-5ebd-475e-8aee-a7b5ab84a5d8"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="e1e5acdc-67d0-4716-81d2-bb587349161f" description="&lt;p>The &amp;#39;abort&amp;#39; event/command, raised when a fault occurs during Execute that cannot be handled by Hold or Suspend. Moves Execute to Aborted; per TR88, this transition can occur from most/any state, though this model currently only wires it from Execute.&lt;/p>&#xA;"
                    triggerDescription="" source="#e976ea35-8b17-4476-b753-05011a4e06d3"
                    target="#994078d8-18a1-4b9c-92ea-8a132b222418" triggers="#96b7ac36-8a70-4b0b-a7d2-7761e65dd035"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="587f7c97-9147-425c-bbf3-4d690cc96e70" description="&lt;p>The &amp;#39;clear&amp;#39; command, issued once the fault causing Abort has been diagnosed and corrected. This is the only way out of Aborted, by design, ensuring no fault goes unacknowledged. Moves Aborted to Idle.&lt;/p>&#xA;"
                    triggerDescription="" source="#994078d8-18a1-4b9c-92ea-8a132b222418"
                    target="#10bcee68-3230-4ab5-ab0b-b2f30ff50ee6" triggers="#67d201d6-7994-4db4-8460-f5e917462b10"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="f3f52b75-6462-4858-9e80-fefd530b88dd" description="&lt;p>The 'reset' command, issued from Complete once a finished run has been acknowledged, preparing the machine for its next run. Moves Complete to Idle.&lt;/p>"
                    triggerDescription="" source="#1e4ebd1c-a1b4-4a38-8c6f-1bf075be2efa"
                    target="#10bcee68-3230-4ab5-ab0b-b2f30ff50ee6" triggers="#07be5c73-fc3f-4197-8616-5140954b2083"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="e56cec36-ea85-4a6f-a26b-a7b1eb3272f6" description="&lt;p>The &amp;#39;reset&amp;#39; command, issued from Stopped to prepare the machine to run again after a full stop. Moves Stopped to Idle.&lt;/p>&#xA;"
                    triggerDescription="" source="#e055180d-1564-4836-a79e-f2f53b4c5ba5"
                    target="#10bcee68-3230-4ab5-ab0b-b2f30ff50ee6" triggers="#07be5c73-fc3f-4197-8616-5140954b2083"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="a6f26321-440b-496d-a54a-b687017a8776" description="&lt;p>The 'unhold' command, issued once the internal condition causing Hold has been resolved. Moves Held directly back to Execute — no Clear or diagnostic step required, since Held is not a logged fault.&lt;/p>"
                    triggerDescription="" source="#f7be3080-a249-4800-9ef3-e4d41b2f617f"
                    target="#e976ea35-8b17-4476-b753-05011a4e06d3" triggers="#91e64d7e-1408-4572-9cb9-2b0d42874a6d"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="e920953c-bb89-445a-a01c-cc37e603332d" description="&lt;p>The 'unsuspend' command, issued once the external/line-level condition causing Suspend has resolved. Moves Suspended directly back to Execute — no Clear or diagnostic step required, since Suspended is not a logged fault.&lt;/p>"
                    triggerDescription="" source="#45f2a968-bbfb-4be8-9627-5df682308606"
                    target="#e976ea35-8b17-4476-b753-05011a4e06d3" triggers="#f7558b87-df00-4ca3-9a8c-ceb1510c8913"/>
                <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                    id="d1919318-b7b9-4b44-8ed3-3d7c4b50daca" description="&lt;p>The &amp;#39;stop&amp;#39; command, typically issued for a planned shutdown of the machine. Moves Execute to Stopped; a subsequent Reset is required before the machine can run again.&lt;/p>&#xA;"
                    triggerDescription="" source="#e976ea35-8b17-4476-b753-05011a4e06d3"
                    target="#e055180d-1564-4836-a79e-f2f53b4c5ba5" triggers="#d46776cf-56b9-49d7-9d21-6231988436ba"/>
              </ownedRegions>
            </ownedStateMachines>
            <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
                id="3c7c80b9-09a7-4c93-b850-50ce05c04e2e" name="Line Control I/F">
              <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                  id="49d9690a-130d-4f09-84b3-85979145d482" targetElement="#c56ac10f-3e01-405e-b3cb-bdd2a1498b4d"
                  sourceElement="#3c7c80b9-09a7-4c93-b850-50ce05c04e2e"/>
              <ownedPortAllocations xsi:type="org.polarsys.capella.core.data.information:PortAllocation"
                  id="61f7d815-0e80-4430-b917-54e065162b24" targetElement="#7b8003ae-2044-43ca-9044-19674ae2b167"
                  sourceElement="#3c7c80b9-09a7-4c93-b850-50ce05c04e2e"/>
            </ownedFeatures>
